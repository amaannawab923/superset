# Copy to .env and edit. pydantic-settings loads this automatically.

# --- Feature gate (A3: COPILOT_WS_ENABLED -> 404 when off) ---
COPILOT_WS_ENABLED=true

# --- LLM ---
ANTHROPIC_API_KEY=            # required unless COPILOT_FAKE_LLM=true
COPILOT_MODEL=claude-opus-5
COPILOT_MAX_TOKENS=16000
COPILOT_THINKING=false        # set true to enable adaptive thinking (needs recent langchain-anthropic)
COPILOT_FAKE_LLM=false        # true = run the whole loop offline with a stub model (no API key needed)

# --- Persistence (A4). SQLite for dev; Postgres for prod. ---
COPILOT_DATABASE_URL=sqlite+aiosqlite:///./copilot.db
# COPILOT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/copilot

# --- Control plane (concurrency gates, cancel flags). In-memory when unset. ---
# COPILOT_REDIS_URL=redis://localhost:6379/0
COPILOT_MAX_CONCURRENT_PER_USER=2

# --- Dev auth shim (real deploy: JWT + RBAC via @protect()) ---
COPILOT_DEV_USER_ID=1
COPILOT_DEV_WORKSPACE_ID=default
